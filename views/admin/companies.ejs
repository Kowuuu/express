<ul>
    <% companies.forEach( company=>{ %>
        <li><%= company.name %><a href="/admin/companies/delete/<%= company.id%>">Delete</a></li>
    <% })%>
</ul>

<form action="/admin/companies/add" method="POST">
    <input type="text" name="name" placeholder="Enter company name" required><br>

    <button type="submit">Create</button>
</form>