<div class="container">

    <header>
        <h1>Job Management Portal</h1>
        <p>Manage database records, track job listings, and control multi-tech assignments.</p>
    </header>

    <div class="workspace-grid">

        <!-- LEFT PANEL: Search -->
        <aside class="panel-card">
            <div class="panel-title-wrapper">
                <span>🔍</span>
                <h2 class="panel-title">Filter Listings</h2>
            </div>
            <form action="/admin/jobs/search" method="GET">
                <div class="form-group">
                    <label>Job Title</label>
                    <input type="text" name="title" placeholder="e.g. Node Developer"/>
                </div>
                <div class="form-group">
                    <label>Minimum Salary</label>
                    <input type="number" name="salary" placeholder="Min amount"/>
                </div>
                <div class="form-group">
                    <label>Date Created</label>
                    <input type="date" name="created_at" />
                </div>

                <div class="form-group">
                    <label for="technology">Required Stack <span style="font-weight: normal; text-transform: none; color: var(--text-muted);">(Hold Ctrl/Cmd to select multiple)</span></label>
                    <select name="technology[]" id="technology" multiple>
                        <% technologies.forEach(technology => { %>
                            <option value="<%= technology.id %>"><%= technology.name %></option>
                        <% }) %>
                    </select>
                </div>

                <button type="submit" class="btn btn-dark">Apply Filters</button>
            </form>
        </aside>

        <!-- CENTER PANEL: Data Output Table -->
        <main class="listings-panel">
            <div class="listings-header">
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                    <span>💼</span>
                    <h2 class="panel-title" style="margin: 0;">Active Jobs</h2>
                </div>
                <span class="badge"><%= jobs.length %> Total</span>
            </div>

            <% if (jobs && jobs.length > 0) { %>
                <div class="listings-container">
                    <% jobs.forEach(job => { %>
                        <div class="job-item">
                            <div class="job-info-block">
                                <h3 class="job-title-text"><%= job.title %></h3>
                                <div class="job-meta-row">
                                    <span>ID: #<%= job.id %></span>
                                    <% if (job.salary) { %>
                                        <span class="salary-tag">$<%= job.salary.toLocaleString() %></span>
                                    <% } %>
                                </div>
                            </div>
                            <a href="/admin/jobs/delete/<%= job.id %>"
                               onclick="return confirm('Are you sure you want to delete this listing?')"
                               class="btn-delete">
                                Delete
                            </a>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <span class="empty-icon">📭</span>
                    <p style="color: var(--text-muted); font-size: 0.875rem;">No job positions found matching your selection.</p>
                </div>
            <% } %>
        </main>

        <!-- RIGHT PANEL: Record Entry -->
        <section class="panel-card">
            <div class="panel-title-wrapper">
                <span>✨</span>
                <h2 class="panel-title">Post New Position</h2>
            </div>

            <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
                <div class="error-alert-box">
                    <div class="error-alert-title">⚠️ Form Validation Failed:</div>
                    <% errors.forEach(error => { %>
                        <p class="error-item"><%= error.msg %></p>
                    <% }) %>
                </div>
            <% } %>

            <form method="POST" action="/admin/jobs/add">
                <div class="form-group">
                    <label for="title">Job Title <span style="color: var(--danger)">*</span></label>
                    <input type="text" id="title" name="title" maxlength="128" required placeholder="e.g. Lead Devops Architect">
                </div>

                <div class="form-group-split">
                    <div>
                        <label for="user_id">Assigned User</label>
                        <select name="user_id" id="user_id">
                            <% users.forEach(user => { %>
                                <option value="<%= user.id %>"><%= user.email %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label for="company_id">Hiring Company</label>
                        <select name="company_id" id="company_id">
                            <% companies.forEach(company => { %>
                                <option value="<%= company.id %>"><%= company.name %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label for="salary">Base Salary (Optional)</label>
                    <input type="number" id="salary" name="salary" placeholder="Annual base pay in USD">
                </div>

                <div class="form-group">
                    <label for="due_date">Application Deadline <span style="color: var(--danger)">*</span></label>
                    <input type="datetime-local" id="due_date" name="due_date" required>
                </div>

                <div class="form-group">
                    <label for="technology">Required Stack <span style="font-weight: normal; text-transform: none; color: var(--text-muted);">(Hold Ctrl/Cmd to select multiple)</span></label>
                    <select name="technology[]" id="technology" multiple>
                        <% technologies.forEach(technology => { %>
                            <option value="<%= technology.id %>"><%= technology.name %></option>
                        <% }) %>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top: 1rem;">Publish Position</button>
            </form>
        </section>

    </div>
</div>
